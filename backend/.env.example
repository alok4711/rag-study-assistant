# Copy this file to .env and fill in your real key. Never commit .env to git.

# Get a key from https://console.anthropic.com/ (used to generate answers)
ANTHROPIC_API_KEY=your-key-here

# Where your vector database will be stored on disk
CHROMA_DB_PATH=./chroma_store

# Where your raw notes live (txt, pdf files)
NOTES_DIR=../data/notes
